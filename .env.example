# Toutes les clés/jetons réels vivent ICI, jamais dans config.json (qui reste versionné avec des champs vides).
# Copie ce fichier en « .env » à la racine du projet et remplis les valeurs dont tu as besoin — aucune n'est obligatoire :
# une variable absente désactive simplement la fonctionnalité correspondante (message clair au démarrage de jarvis.js).

# Bot Telegram (BotFather) — contrôle à distance, notifications, boutons de confirmation.
TELEGRAM_TOKEN=

# Google AI Studio — LLM principal (Gemini).
GEMINI_KEY=

# GitHub (Personal Access Token, lecture seule suffit) — résumé des dépôts dans le tableau de bord.
GITHUB_TOKEN=

# Netlify (Personal Access Token) — état des déploiements dans le tableau de bord.
NETLIFY_TOKEN=

# Groq (compatible API OpenAI) — IA de secours si Gemini est indisponible.
GROQ_KEY=

# Spotify — Client ID de l'application (flux PKCE, pas de client secret nécessaire).
SPOTIFY_CLIENT_ID=

# Identifiants d'un portail tiers synchronisé dans l'agenda (voir fac.js) — n'importe quel portail avec
# connexion email/mot de passe et sans API publique, pas forcément un établissement scolaire.
FAC_EMAIL=
FAC_MOT_DE_PASSE=
# URL de ce portail (page de connexion, vue "emploi du temps"). Laisse vide pour garder le placeholder par défaut.
FAC_BASE_URL=

# Clé API publique N8N (Settings > n8n API) — utilisée pour créer des workflows (toujours désactivés par défaut).
N8N_API_KEY=

# Jeton interne du serveur HTTP local (protège son unique port). Laisse vide : un jeton aléatoire est généré
# automatiquement au premier démarrage et réutilisé ensuite ; ne le définis ici que si tu veux en imposer un toi-même.
VOICE_TOKEN=
